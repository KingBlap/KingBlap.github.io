<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.jet_guide" name="TV Guide - Beta" version="0.0.21" provider-name="JetJet">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests"/>
        <import addon="script.module.routing"/>
        <import addon="script.module.unidecode"/>
        <import addon="script.module.inputstreamhelper"/>
        <import addon="script.module.resolveurl"/>
        <import addon="script.module.beautifulsoup4"/>
        <import addon="script.module.tzlocal" />
        <import addon="script.module.jetextractors"/>
        <import addon="script.module.pytz"/>
        <import addon="plugin.video.jetproxy" optional="true" />
        <import addon="inputstream.ffmpegdirect" />
        <import addon="script.service.livescore_alerts" optional="true"/>
        <import addon="inputstream.adaptive"/>
        <import addon="script.module.pyamf"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.python.script" library="gui_launcher.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
        <summary lang="en">TV Guide Add-on</summary>
        <description lang="en">A TV guide add-on for streaming channels.</description>
        <platform>all</platform>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>